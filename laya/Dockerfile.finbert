# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Laya System 1 — FinBERT transformer mode (~2.5 GB image!)
#
#   docker build -f Dockerfile.finbert -t laya-engine:finbert .
#   docker run -d --name laya --restart unless-stopped -p 8000:8000 laya-engine:finbert
#
# Loads ProsusAI/finbert at BUILD time so the container starts warm.
# CPU inference ≈ 100–300 ms/post (vs <1 ms heuristic). The radar's 40/tick
# inference budget still absorbs this, but the HUD latency will read higher.
# The default Dockerfile (heuristic) is the honest fast path — use this only
# if you want transformer-grade directional scoring.
# ─────────────────────────────────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LAYA_MODE=finbert

RUN pip install --no-cache-dir \
    "fastapi>=0.110" "uvicorn[standard]>=0.29" \
    torch --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir "transformers>=4.44"

# bake the model into the image (no download at runtime)
RUN python -c "from transformers import pipeline; pipeline('text-classification', model='ProsusAI/finbert')"

COPY app.py engine.py ./

RUN useradd -m laya
USER laya

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=2).status < 500 else 1)"

CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
